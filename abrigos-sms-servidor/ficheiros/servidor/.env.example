# Variáveis da função serverless — configurar no painel da Vercel (Settings → Environment Variables).
# NUNCA fazer commit dos valores.

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMERO=

# Base de dados Redis (Upstash, criada em Vercel → Storage). A Vercel preenche estas duas sozinha.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Endereços autorizados a chamar a API, separados por vírgulas
ORIGENS_PERMITIDAS=https://UTILIZADOR.github.io,http://localhost:5173

# Texto qualquer, secreto, usado para não guardar os IP em claro
SAL_IP=
